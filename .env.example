# Thrap – environment configuration
# Copy this file to .env.local and fill in your key.
# This file is safe to commit. .env.local is gitignored.

# OpenRouter API key (server-side only — never exposed to the browser)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the chat model (default: anthropic/claude-haiku-4.5)
# Any OpenRouter model id works. See https://openrouter.ai/models
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- Embeddings ------------------------------------------------------------
# Semantic retrieval needs an embedding model. Without one the knowledge base
# still works, using lexical (BM25) retrieval only.
#
# Embeddings default to OpenRouter on the same key. They are configured
# separately from chat so that a key which serves chat but refuses embeddings
# does not cost you semantic retrieval — point them at another provider
# instead. Only the key for the selected provider is read.
#
# EMBEDDING_PROVIDER=openrouter     # openrouter | openai | gemini
# EMBEDDING_MODEL=openai/text-embedding-3-small
#
# Read only when EMBEDDING_PROVIDER matches:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
